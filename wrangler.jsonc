{
  // Anthology is a client-only SPA: Workers Static Assets serve `dist`
  // directly — no Worker code, no API routes. `single-page-application`
  // serves index.html for unknown paths (react-router deep links), which
  // replaces the GitHub Pages 404.html trick.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "memory-inbytes-xyz",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
